   "source": [
    "def f(x):\n",
    "    return x ** 3 - 2 * x\n",
    "\n",
    "def numerical_derivative(f, x, eps=1e-5):\n",
    "    return (f(x + eps) - f(x - eps)) / ( 2 * eps)\n",
    "\n",
    "print(numerical_derivative(f, 1))\n",
    "print(3 * 1 ** 2 - 2)"
   ]
  }
