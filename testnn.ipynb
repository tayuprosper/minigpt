   "source": [
    "import numpy as np\n",
    "from llm.tensor import Tensor\n",
    "from llm.nn import Linear, manual_seed\n",
    "\n",
    "\n",
    "manual_seed(0)\n",
    "layer = Linear(3,2)\n",
    "print(layer.num_params(), [p.shape for p in layer.parameters()])\n",
    "y = layer(Tensor(np.ones((4,3), dtype=np.float32)))\n",
    "print(y.shape)"
   ]
  }
